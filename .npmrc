# Keep workspace package trees stable between installs. Electron packaging has
# its own production-dependency staging hook in .erb/scripts/ensure-app-deps.cjs.
node-linker=isolated

# Auto-install peer dependencies
auto-install-peers=true

# Preserved from original npm config
node-options=--max-old-space-size=4096
update-notifier=false
# Fail fast when a shell is using an unsupported Node.js version.
engine-strict=true
